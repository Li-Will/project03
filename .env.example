# ===== LLM（OpenAI 兼容端点，可空 = 规则分支确定性降级）=====
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# ===== 检索 =====
# local | server（server 需自建 Qdrant 容器；local 免依赖直接跑）
QDRANT_MODE=local
QDRANT_PATH=data/qdrant
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=faq_articles

# 离线模型缓存（可选）：指到已下载好的 HF 缓存即可免联网
#   HF_HOME=/home/administrator/.cache/p408qa   （复用 408 项目模型缓存）
#   HF_HUB_OFFLINE=1                            （强制离线，不触发下载/更新检查）

# ===== 业务 =====
# SQLite 业务库 + Checkpoint 库路径
DB_PATH=data/tickets.db
SLA_SCAN_SECONDS=300