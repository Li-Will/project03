# ===== LLM（OpenAI 兼容端点，可空 = 规则分支确定性降级）=====
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# ===== 检索 =====
# local | server（server 需自建 Qdrant 容器；local 免依赖直接跑）
QDRANT_MODE=local
QDRANT_PATH=data/qdrant
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=faq_articles

# ===== 检索增强（P0-2）=====
# 索引文本字段策略：question | question+aliases | question+aliases+answer
# aliases 是语料里的口语变体，进索引后口语提问才能命中（实测 faq 解决率 0.975 → 1.000）
FAQ_INDEX_FIELDS=question+aliases
# 关键词侧召回（字符 bigram BM25，零依赖）与稠密结果做 RRF 融合
USE_BM25=true
# Cross-Encoder 精排（对比文本 = question+aliases；把 answer 全文塞进去会稀释匹配）
USE_RERANK=true
# 级联闸门：稠密 top1 余弦 ≥ 该值 → 跳过精排（常见问题保持毫秒级）
RERANK_GATE=0.60
RERANK_MODEL=jinaai/jina-reranker-v2-base-multilingual
RERANK_THREADS=4
RERANK_DOC_FIELDS=question+aliases
# 置信度阈值：由 scripts/tune_threshold.py 扫描校准（实测可行区间 [0.49, 0.62]）
CONF_DIRECT=0.60
CONF_HINT=0.55

# 离线模型缓存（可选）：指到已下载好的 HF 缓存即可免联网
#   HF_HOME=/home/administrator/.cache/p408qa   （复用 408 项目模型缓存）
#   HF_HUB_OFFLINE=1                            （强制离线，不触发下载/更新检查）

# ===== 鉴权与租户（P0-3）=====
# 格式：key:租户:坐席名[:角色]，逗号分隔。空 = 不启用鉴权（本地演示/评测/CI 零密钥可跑）
#   例：API_KEYS=sk-a:tenantA:坐席甲,sk-b:tenantB:坐席乙
API_KEYS=
# 生产必须设 true：**坐席/管理端点**（human-reply / admin/*）要求 X-API-Key，
# 且坐席身份来自凭据而非请求体（body 里的 actor 一律忽略）
# 注意：用户侧入口（/chat、/ack、工单详情）不强制 —— 终端用户没有坐席凭据；
# 匿名请求归 DEFAULT_TENANT，因此天然看不到具名租户的数据
REQUIRE_AUTH=false
DEFAULT_TENANT=default

# ===== 业务 =====
# SQLite 业务库 + Checkpoint 库路径
DB_PATH=data/tickets.db
SLA_SCAN_SECONDS=300